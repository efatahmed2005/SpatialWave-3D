{
  "manifest_version": 3,
  "name": "SpatialWave 3D - Audiophile Binaural & 8D Engine",
  "version": "1.0.0",
  "description": "Audiophile-grade 3D binaural & 8D spatial audio engine for headphones. Powered by C++ WASM HRTF, Parametric EQ & AutoEQ.",
  "permissions": [
    "tabCapture",
    "offscreen",
    "storage",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "SpatialWave 3D Engine",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Open SpatialWave 3D popup"
    },
    "toggle_spatial": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Toggle 3D Spatial Audio processing on/off"
    },
    "increase_intensity": {
      "suggested_key": {
        "default": "Alt+Shift+Up"
      },
      "description": "Increase 3D spatial intensity"
    },
    "decrease_intensity": {
      "suggested_key": {
        "default": "Alt+Shift+Down"
      },
      "description": "Decrease 3D spatial intensity"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "dsp/*",
        "offscreen/*",
        "icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
